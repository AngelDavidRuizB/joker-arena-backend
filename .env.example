# ==============================================================================
# JokerArena: Multiverse Poker Engine - Variables de Entorno de Ejemplo
# ==============================================================================

# Frontend (Web Client SPA)
FRONTEND_PORT=3000

# PostgreSQL

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jokerarena_db
POSTGRES_PORT=5432

# MongoDB
MONGO_INITDB_DATABASE=jokerarena_telemetry
MONGO_PORT=27017

# Game Engine (Go)
GAME_ENGINE_PORT=8080
GAME_ENGINE_DB_URL=postgres://postgres:postgres@jokerarena-game-db:5432/jokerarena_db?sslmode=disable
TELEMETRY_GRPC_ADDR=jokerarena-telemetry-ms:50051

# Telemetry Service (Python)
TELEMETRY_HTTP_PORT=8000
TELEMETRY_GRPC_PORT=50051
TELEMETRY_MONGO_URL=mongodb://jokerarena-telemetry-db:27017

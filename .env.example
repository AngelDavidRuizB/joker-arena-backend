# ==============================================================================
# JokerArena - Variables de entorno
# Copie este archivo a .env y reemplace los valores <...>. NUNCA versione el .env.
#
#   Prototipo 2:  docker compose -f docker-compose.p2.yml up -d --build --wait
#   Prototipo 1:  docker compose up -d --build   (sección al final)
# ==============================================================================

# ------------------------------------------------------------------------------
# PROTOTIPO 2
# ------------------------------------------------------------------------------
# --- Infraestructura (Ángel) ---
POSTGRES_PASSWORD=<password-postgres-superusuario>
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=<password-mongo>
NEO4J_PASSWORD=<password-neo4j-minimo-8-caracteres>
RABBITMQ_USER=jokerarena
RABBITMQ_PASSWORD=<password-rabbitmq>

# --- Usuarios de PostgreSQL por servicio (un esquema cada uno) ---
AUTH_DB_PASSWORD=<password-svc_auth>
LOBBY_DB_PASSWORD=<password-svc_lobby>
GAME_DB_PASSWORD=<password-svc_game>
LIVEOPS_DB_PASSWORD=<password-svc_liveops>
# Usuario de solo lectura (pg_monitor) para cluster-monitor-ms
MONITOR_DB_PASSWORD=<password-svc_monitor>

# --- auth-identity-ms (Esteban): contraseña del alias "admin" (rol admin, rutas /admin) ---
ADMIN_PASSWORD=<password-admin>

# --- cluster-monitor-ms (Ángel): grupo dueño de /var/run/docker.sock ---
# Linux: stat -c %g /var/run/docker.sock   ·   Docker Desktop (Windows/Mac): 0
DOCKER_GID=0

# --- Puertos publicados en el host (solo gateway y web; el resto es depuración) ---
GATEWAY_PORT=8080
WEB_PORT=3000
NEO4J_HTTP_PORT=7474
RABBITMQ_MGMT_PORT=15672
# Si el navegador no abre el juego en localhost, la URL pública del WebSocket del gateway:
# PUBLIC_GATEWAY_WS_URL=ws://mi-servidor:8080

# ------------------------------------------------------------------------------
# PROTOTIPO 1 (docker-compose.yml) - se conserva sin cambios
# ------------------------------------------------------------------------------
# Frontend (Web Client SPA)
FRONTEND_PORT=3000

# PostgreSQL (contenedor local) - puerto publicado en el host
POSTGRES_USER=appuser
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# MongoDB (contenedor local) - puerto publicado en el host
MONGO_DB=casino_games
MONGO_AUTH_SOURCE=admin
MONGO_PORT=27017

# Game Engine (Go)
GAME_ENGINE_PORT=8080
# postgres (por defecto, persistente) | memory (solo pruebas locales sin BD)
STORAGE_MODE=postgres
TELEMETRY_GRPC_ADDR=jokerarena-telemetry-ms:50051

# Telemetry Service (Python)
TELEMETRY_HTTP_PORT=8000
TELEMETRY_GRPC_PORT=50051

# NOTA: si los puertos 5432 u 8080 están ocupados en su máquina (Windows suele
# tener postgresql-x64-* o servicios en 8080), cambie POSTGRES_PORT / GAME_ENGINE_PORT
# (por ejemplo 5434 y 8082). Entre contenedores se usan siempre los puertos internos.

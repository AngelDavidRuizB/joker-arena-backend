# Los scripts y configuraciones que se ejecutan dentro de contenedores Linux deben quedar
# con fin de línea LF aunque el repo se clone en Windows (core.autocrlf).
*.sh            text eol=lf
*.sql           text eol=lf
*.conf          text eol=lf
*.cypher        text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf

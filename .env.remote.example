# ==============================================================================
# JokerArena - Conexión al servidor REMOTO compartido (opcional)
# Añada estas líneas a su .env para que el Game Engine use la BD PostgreSQL remota
# en lugar del contenedor local. El esquema ya existe en el servidor: NO se altera.
# El contenedor local de Postgres seguirá levantándose pero no será utilizado.
#
# ADVERTENCIA: la BD remota es compartida. No ejecute las suites de pruebas
# destructivas contra ella (usan datos de prueba y crean filas).
# ==============================================================================
GAME_DB_HOST=149.130.189.181
GAME_DB_PORT=5432
GAME_DB_USER=appuser
GAME_DB_PASSWORD=<password-postgres>
GAME_DB_NAME=appdb
GAME_DB_SSLMODE=disable

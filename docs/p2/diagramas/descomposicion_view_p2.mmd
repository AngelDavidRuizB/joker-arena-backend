flowchart LR
  SYS["JokerArena: Multiverse Poker Engine"]

  SYS --> ID["Identidad"]
  SYS --> LOB["Lobby y salas"]
  SYS --> GAME["Juego"]
  SYS --> AI["IA del oponente"]
  SYS --> TELM["Telemetría y auditoría"]
  SYS --> RANK["Ranking y estadísticas"]
  SYS --> LIVE["LiveOps / Balance"]
  SYS --> OBS["Observabilidad"]
  SYS --> UI["Interfaces de usuario"]
  SYS --> EDGE["Borde y mensajería"]

  ID --> ID1["auth-identity-ms<br/>registro · login · JWT/JWKS · sesiones"]
  LOB --> LOB1["rooms-lobby-ms<br/>códigos JKR-XXXX · unión · estado de sala"]
  GAME --> GAME1["game-engine-ms"]
  GAME1 --> G1["sesión WS por sala (actor)"]
  GAME1 --> G2["póker: baraja · evaluador · puntuación"]
  GAME1 --> G3["ruleset en memoria (hot reload)"]
  GAME1 --> G4["publicador de eventos"]
  AI --> AI1["bot-ai-ms<br/>decisión jugar/descartar por dificultad"]
  TELM --> TELM1["telemetry-ms<br/>ingesta de eventos · consultas de auditoría"]
  RANK --> RANK1["leaderboard-stats-ms"]
  RANK1 --> R1["consumidor de eventos"]
  RANK1 --> R2["proyección en grafo (Neo4j)"]
  RANK1 --> R3["API de ranking + caché"]
  LIVE --> LIVE1["liveops-rules-ms<br/>ruleset versionado · feature flags"]
  OBS --> OBS1["cluster-monitor-ms<br/>sondas · alarmas · WS de métricas"]
  UI --> UI1["web-ssr<br/>páginas SSR · mesa de juego · consola admin (Editor + Radar)"]
  UI --> UI2["cli<br/>comandos de terminal · watch en vivo"]
  EDGE --> EDGE1["API Gateway (nginx)"]
  EDGE --> EDGE2["RabbitMQ"]
